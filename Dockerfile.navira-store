####################################################################################################
## Build
####################################################################################################
FROM rust:alpine AS builder

RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache lld musl musl-dev clang git make ca-certificates

WORKDIR /app
COPY . ./
RUN cargo build --release --features mimalloc -p navira-store

####################################################################################################
## This stage is used to get the correct files into the final image
####################################################################################################
FROM alpine:latest AS files

# mailcap is used for content type (MIME type) detection
# tzdata is used for timezones info
RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache ca-certificates

RUN update-ca-certificates

ENV USER=navira
ENV UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid "${UID}" \
    "${USER}"


####################################################################################################
## Final image
####################################################################################################
FROM scratch AS final

COPY --from=files --chmod=444 \
    /etc/passwd \
    /etc/group \
    /etc/

COPY --from=files --chmod=444 /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

COPY --from=builder /app/target/release/navira-store /bin/navira-store

# Use an unprivileged user.
USER navira:navira

WORKDIR /app

ENTRYPOINT ["/bin/navira-store", "--config", "/app/config/", "--datastore", "/app/datastore/"]
EXPOSE 8080